---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import { withBase } from '../lib/url';
import { feedbackUrl } from '../lib/feedback';

interface Props { title?: string; description?: string }
const {
  title = 'Agent platform selection for Microsoft 365 and Copilot Studio',
  description = 'Assess conversational agent use cases across Microsoft 365 and Copilot Studio by audience, work direction and required capabilities.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} (Draft) | Agent platform guidance</title>
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <script is:inline>
      (() => {
        const param = new URLSearchParams(location.search).get('scoutTheme');
        document.documentElement.dataset.theme = param === 'light' || param === 'dark'
          ? param : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href={withBase('#main')}>Skip to content</a>
    <header class="preview-header">
      <div class="preview-header-inner">
        <a class="brand" href={withBase('#guide/audience')} data-nav aria-label="Agent platform guidance home">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h8M4 5v14h15M4 12h15" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="5" r="2" fill="currentColor"/><circle cx="19" cy="12" r="2" fill="currentColor"/><circle cx="19" cy="19" r="2" fill="currentColor"/></svg>
          <span>Agent platform guidance</span>
        </a>
        <div class="header-tools">
          <div class="header-feedback">
            <a href={feedbackUrl()} target="_blank" rel="noopener noreferrer" aria-describedby="header-feedback-notice">Submit feedback</a>
            <span id="header-feedback-notice">Public GitHub issue · Account required · New tab</span>
          </div>
          <button id="theme" class="theme-button" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="preview-shell" tabindex="-1"><slot /></main>
    <footer class="preview-footer">
      <a href={withBase('#scope')} data-nav>Scope</a>
      <span>Answers stay in this tab and reset on refresh. No information is submitted automatically.</span>
    </footer>
  </body>
</html>
