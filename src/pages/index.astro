---
import Layout from '../layouts/Layout.astro';
import { documentation } from '../data/guidance';
---
<Layout>
  <section aria-labelledby="page-title">
    <h1 id="page-title">Agent platform selection for Microsoft 365 and Copilot Studio (Draft)</h1>
    <p class="reference-intro">Guidance for platform owners, Center of Excellence leads and architects assessing conversational agent use cases.</p>
    <noscript>
      <p id="no-script-message" class="reference-intro">The interactive assessment requires JavaScript. You can review the official documentation directly:</p>
      <ul class="documentation-links" aria-label="Platform documentation">
        {[documentation.builder, documentation.cowork, documentation.microsoftHarness, documentation.standardHarness, documentation.sdk].map(link => (
          <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
        ))}
      </ul>
      <section id="scope" class="reference-section">
        <h2>Scope</h2>
        <p>This guidance covers conversational agent experiences. Standalone business-process automation is outside this assessment. Recommendations identify starting points; confirm capabilities, permissions and publishing support for your use case.</p>
      </section>
      <style is:inline>#theme { display: none; }</style>
    </noscript>
  </section>
  <script>
    import '../scripts/finder';
  </script>
</Layout>
