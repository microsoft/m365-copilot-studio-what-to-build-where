---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
---
<Layout>
  <div class="page-shell">
    <section class="intro" aria-labelledby="page-title">
      <h1 id="page-title">Agent platform selection for Microsoft 365 and Copilot Studio (Draft)</h1>
      <p>This guidance helps platform owners, Center of Excellence (CoE) leads, and platform architects assess agentic use cases across Microsoft 365 and Microsoft Copilot Studio. Choose an overall approach, answer its focused questions, and review the relevant platforms and prerequisites for development.</p>
    </section>
    <div class="guidance-notice"><span class="draft-badge">Draft guidance</span><p>Review flagged requirements and confirm platform capabilities before development. <a href={withBase('compare/#about')}>How this works</a></p></div>
    <noscript><div class="notice">The interactive guide needs JavaScript. You can still <a href={withBase('compare/')}>compare all six options</a> without it.</div></noscript>
    <div class="workspace" id="finder" hidden>
      <section class="decision-panel" aria-label="Interactive agent platform guidance">
        <div class="progress-row">
          <span id="step-label" class="utility"></span>
          <div class="progress-actions">
            <button id="shortlist-jump" class="shortlist-jump" type="button" aria-controls="platform-shortlist">6 platforms remain</button>
            <button class="reset-button" id="restart" type="button" disabled>Reset answers</button>
          </div>
        </div>
        <div class="progress-track" role="progressbar" aria-label="Question progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="progress-fill"></span></div>
        <form id="question-form" novalidate>
          <div id="question-content"></div>
          <p class="form-error" id="form-error" role="alert" hidden></p>
          <div class="question-actions">
            <button type="button" class="button button-quiet" id="back">Back</button>
            <span class="selection-hint" id="selection-hint">Choose one option</span>
            <button type="submit" class="button button-primary" id="continue">Continue</button>
          </div>
        </form>
        <div id="result" hidden></div>
        <div class="context-feedback">
          <a id="context-feedback-link" target="_blank" rel="noopener noreferrer" aria-describedby="context-feedback-notice">Give feedback on this step</a>
          <p id="context-feedback-notice">Opens a new tab and sends your current selections to GitHub to fill an editable issue form. A GitHub account is required. Review before submitting a public issue.</p>
        </div>
      </section>
      <aside class="assessment-panel" aria-label="Assessment details">
        <div class="sidebar-tabs" role="tablist" aria-label="Assessment view">
          <button id="shortlist-tab" type="button" role="tab" aria-selected="true" aria-controls="platform-shortlist">Platform shortlist <span id="shortlist-count" class="count">6</span></button>
          <button id="requirements-tab" type="button" role="tab" aria-selected="false" aria-controls="requirements" tabindex="-1">Your requirements <span id="answer-count" class="count">0</span></button>
        </div>
        <p id="shortlist-status" class="shortlist-status" role="status" aria-live="polite" aria-atomic="true"></p>
        <section id="platform-shortlist" class="sidebar-tabpanel" role="tabpanel" aria-labelledby="shortlist-tab" tabindex="0">
          <p class="shortlist-help" id="shortlist-help">Choose an approach to see its two currently covered platforms.</p>
          <p class="shortlist-help" id="approach-scope" hidden></p>
          <div id="applicable-platforms"></div>
          <div id="conditional-platforms"></div>
          <details id="excluded-platforms" class="excluded-platforms" hidden>
            <summary>Excluded <span id="excluded-count" class="count">0</span></summary>
            <div id="exclusion-reasons"></div>
          </details>
          <p class="shortlist-help" id="outside-approach" hidden></p>
        </section>
        <section id="requirements" class="sidebar-tabpanel" role="tabpanel" aria-labelledby="requirements-tab" tabindex="0" hidden>
          <p class="summary-help">Review or edit your recorded requirements.</p>
          <ol id="answer-summary"></ol>
          <div class="empty-summary" id="empty-summary"><p>Your answers will appear here.</p></div>
        </section>
      </aside>
    </div>
  </div>
  <script>
    import '../scripts/finder';
  </script>
</Layout>
